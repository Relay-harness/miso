    "@fontsource/geist-sans": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
